<UserControl x:Class="EpgTimer.Setting.SetEpgView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EpgTimer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="780" d:DataContext="{d:DesignInstance local:Settings}" DataContextChanged="UserControl_DataContextChanged">
    <UserControl.Resources>
        <local:ToStringValueIsNotEqualConverter x:Key="notEqualConvert" />
        <local:ToStringValueIsOneOrZeroConverter x:Key="convert" />
        <local:ToStringValueIsZeroOrOneConverter x:Key="invert" />
    </UserControl.Resources>
    <TabControl>
        <TabItem Header="基本">
            <StackPanel Margin="{StaticResource AppEdgeMarginLTR}" Name="grid_basic">
                <StackPanel Orientation="Horizontal">
                    <Label Content="デザイン" Style="{StaticResource AppTermLabelStyle}" />
                    <UniformGrid Rows="1">
                        <RadioButton Checked="radioButton_basicDesign_Checked" Content="デフォルト" IsChecked="True" Name="radioButton_basicDesignDefault" Style="{StaticResource AppToggleButtonStyle}" />
                        <RadioButton Checked="radioButton_basicDesign_Checked" Content="サブ1" Name="radioButton_basicDesignSub1" Style="{StaticResource AppToggleButtonStyle}" />
                        <RadioButton Checked="radioButton_basicDesign_Checked" Content="サブ2" Name="radioButton_basicDesignSub2" Style="{StaticResource AppToggleButtonStyle}" />
                    </UniformGrid>
                    <Label Content="※デフォルトデザインの設定の一部は番組表以外にも影響します。" IsEnabled="{Binding IsChecked, ElementName=radioButton_basicDesignDefault}" Margin="{StaticResource AppWideMarginL}" Style="{StaticResource AppLabelStyle}" />
                </StackPanel>
                <GroupBox Header="フォント" Margin="{StaticResource AppEdgeMarginT}">
                    <Grid Margin="{StaticResource AppMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Content="タイトル" Style="{StaticResource AppTermLabelStyle}" />
                        <Label Content="フォント" Grid.Column="1" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="2" IsEditable="True" Name="comboBox_fontTitle" Style="{StaticResource AppComboBoxStyle}" Text="{Binding FontNameTitle}" />
                        <Label Content="サイズ" Grid.Column="3" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppTermLabelStyle}" />
                        <local:SpinTextBox Grid.Column="4" InputMethod.IsInputMethodEnabled="False" Text="{Binding FontSizeTitle}" />
                        <StackPanel Grid.Column="5" Grid.ColumnSpan="3" Orientation="Horizontal">
                        <Label Content="太さ" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppTermLabelStyle}" />
                        <Slider IsSnapToTickEnabled="True" LargeChange="100" Maximum="900" Minimum="100" Name="slider_weightTitle" SmallChange="100" TickFrequency="100" ToolTip="100(細い)〜900(太い)。フォントに用意されている太さのうち、近いものが使われます(太さの種類がないフォントでは変わらないことがあります)" Value="{Binding FontWeightTitle}" VerticalAlignment="Center" Width="150" />
                        <Label Content="{Binding Value, ElementName=slider_weightTitle}" MinWidth="36" Style="{StaticResource AppLabelStyle}" />
                        </StackPanel>
                        <FrameworkElement Grid.Row="1" Margin="{StaticResource AppMarginT}" />
                        <Label Content="タイトル以外" Grid.Row="2" Style="{StaticResource AppTermLabelStyle}" />
                        <Label Content="フォント" Grid.Column="1" Grid.Row="2" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="2" Grid.Row="2" IsEditable="True" Name="comboBox_font" Style="{StaticResource AppComboBoxStyle}" Text="{Binding FontName}" />
                        <Label Content="サイズ" Grid.Column="3" Grid.Row="2" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppTermLabelStyle}" />
                        <local:SpinTextBox Grid.Column="4" Grid.Row="2" InputMethod.IsInputMethodEnabled="False" Text="{Binding FontSize}" />
                        <StackPanel Grid.Column="5" Grid.ColumnSpan="3" Grid.Row="2" Orientation="Horizontal">
                        <Label Content="太さ" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppTermLabelStyle}" />
                        <Slider IsSnapToTickEnabled="True" LargeChange="100" Maximum="900" Minimum="100" Name="slider_weightNormal" SmallChange="100" TickFrequency="100" ToolTip="100(細い)〜900(太い)。フォントに用意されている太さのうち、近いものが使われます(太さの種類がないフォントでは変わらないことがあります)" Value="{Binding FontWeightNormal}" VerticalAlignment="Center" Width="150" />
                        <Label Content="{Binding Value, ElementName=slider_weightNormal}" MinWidth="36" Style="{StaticResource AppLabelStyle}" />
                        </StackPanel>
                        <FrameworkElement Grid.Row="3" Margin="{StaticResource AppMarginT}" />
                        <Label Content="サービス名" Grid.Row="4" Style="{StaticResource AppTermLabelStyle}" />
                        <Label Content="フォント" Grid.Column="1" Grid.Row="4" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="2" Grid.Row="4" IsEditable="True" Name="comboBox_fontHeader" Style="{StaticResource AppComboBoxStyle}" Text="{Binding FontNameHeader}" />
                        <Label Content="サイズ" Grid.Column="3" Grid.Row="4" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppTermLabelStyle}" />
                        <local:SpinTextBox Grid.Column="4" Grid.Row="4" InputMethod.IsInputMethodEnabled="False" Text="{Binding FontSizeHeader}" />
                        <StackPanel Grid.Column="5" Grid.ColumnSpan="3" Grid.Row="4" Orientation="Horizontal">
                            <Label Content="行の高さ" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppTermLabelStyle}" />
                            <local:SpinTextBox InputMethod.IsInputMethodEnabled="False" Fallback="0" Minimum="0" Text="{Binding HeaderHeight}" Width="120" />
                            <Label Content="px" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppLabelStyle}" />
                            <Label Content="太さ" Margin="{StaticResource AppWideMarginL}" Style="{StaticResource AppTermLabelStyle}" />
                            <Slider IsSnapToTickEnabled="True" LargeChange="100" Maximum="900" Minimum="100" Name="slider_weightHeader" SmallChange="100" TickFrequency="100" ToolTip="100(細い)〜900(太い)。フォントに用意されている太さのうち、近いものが使われます(太さの種類がないフォントでは変わらないことがあります)" Value="{Binding FontWeightHeader}" VerticalAlignment="Center" Width="120" />
                            <Label Content="{Binding Value, ElementName=slider_weightHeader}" MinWidth="30" Style="{StaticResource AppLabelStyle}" />
                        </StackPanel>
                        <FrameworkElement Grid.Row="5" Margin="{StaticResource AppMarginT}" />
                        <Label Content="日付(1週間モード)" Grid.Row="6" Style="{StaticResource AppTermLabelStyle}" />
                        <Label Content="フォント" Grid.Column="1" Grid.Row="6" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="2" Grid.Row="6" IsEditable="True" Name="comboBox_fontHeaderWeek" Style="{StaticResource AppComboBoxStyle}" Text="{Binding FontNameHeaderWeek}" />
                        <Label Content="サイズ" Grid.Column="3" Grid.Row="6" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppTermLabelStyle}" />
                        <local:SpinTextBox Grid.Column="4" Grid.Row="6" InputMethod.IsInputMethodEnabled="False" Text="{Binding FontSizeHeaderWeek}" />
                        <StackPanel Grid.Column="5" Grid.ColumnSpan="3" Grid.Row="6" Orientation="Horizontal">
                            <Label Content="行の高さ" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppTermLabelStyle}" />
                            <local:SpinTextBox InputMethod.IsInputMethodEnabled="False" Fallback="0" Minimum="0" Text="{Binding HeaderHeightWeek}" Width="120" />
                            <Label Content="px" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppLabelStyle}" />
                            <Label Content="太さ" Margin="{StaticResource AppWideMarginL}" Style="{StaticResource AppTermLabelStyle}" />
                            <Slider IsSnapToTickEnabled="True" LargeChange="100" Maximum="900" Minimum="100" Name="slider_weightHeaderWeek" SmallChange="100" TickFrequency="100" ToolTip="100(細い)〜900(太い)。フォントに用意されている太さのうち、近いものが使われます(太さの種類がないフォントでは変わらないことがあります)" Value="{Binding FontWeightHeaderWeek}" VerticalAlignment="Center" Width="120" />
                            <Label Content="{Binding Value, ElementName=slider_weightHeaderWeek}" MinWidth="30" Style="{StaticResource AppLabelStyle}" />
                        </StackPanel>
                        <FrameworkElement Grid.Row="7" Margin="{StaticResource AppMarginT}" />
                        <Label Content="時間軸" Grid.Row="8" Style="{StaticResource AppTermLabelStyle}" />
                        <Label Content="フォント" Grid.Column="1" Grid.Row="8" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="2" Grid.Row="8" IsEditable="True" Name="comboBox_fontTimeHeader" Style="{StaticResource AppComboBoxStyle}" Text="{Binding FontNameTimeHeader}" />
                        <Label Content="サイズ" Grid.Column="3" Grid.Row="8" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppTermLabelStyle}" />
                        <local:SpinTextBox Grid.Column="4" Grid.Row="8" InputMethod.IsInputMethodEnabled="False" Text="{Binding FontSizeTimeHeader}" />
                        <StackPanel Grid.Column="5" Grid.ColumnSpan="3" Grid.Row="8" Orientation="Horizontal">
                            <Label Content="表示位置" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppTermLabelStyle}" />
                            <ComboBox PreviewKeyDown="comboBox_NoContextMenu_PreviewKeyDown" PreviewMouseRightButtonUp="comboBox_NoContextMenu_PreviewMouseRightButtonUp" SelectedIndex="{Binding TimeHeaderPlace}" Style="{StaticResource AppComboBoxStyle}" Width="150">
                                <ComboBoxItem Content="両端" />
                                <ComboBoxItem Content="左端のみ" />
                                <ComboBoxItem Content="右端のみ" />
                            </ComboBox>
                            <Label Content="幅" Margin="{StaticResource AppWideMarginL}" Style="{StaticResource AppTermLabelStyle}" />
                            <local:SpinTextBox InputMethod.IsInputMethodEnabled="False" Fallback="0" Minimum="0" Text="{Binding TimeHeaderWidth}" Width="120" />
                            <Label Content="px" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppLabelStyle}" />
                            <Label Content="太さ" Margin="{StaticResource AppWideMarginL}" Style="{StaticResource AppTermLabelStyle}" />
                            <Slider IsSnapToTickEnabled="True" LargeChange="100" Maximum="900" Minimum="100" Name="slider_weightTimeHeader" SmallChange="100" TickFrequency="100" ToolTip="100(細い)〜900(太い)。フォントに用意されている太さのうち、近いものが使われます(太さの種類がないフォントでは変わらないことがあります)" Value="{Binding FontWeightTimeHeader}" VerticalAlignment="Center" Width="120" />
                            <Label Content="{Binding Value, ElementName=slider_weightTimeHeader}" MinWidth="30" Style="{StaticResource AppLabelStyle}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
                <GroupBox Header="表示" Margin="{StaticResource AppEdgeMarginT}">
                    <StackPanel Margin="{StaticResource AppMargin}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="マウス縦スクロールサイズ" Style="{StaticResource AppTermLabelStyle}" />
                            <TextBox Grid.Column="1" InputMethod.IsInputMethodEnabled="False" IsEnabled="{Binding IsChecked, Converter={StaticResource invert}, ElementName=checkBox_mouseScrollAuto}" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding ScrollSize}" />
                            <CheckBox Content="自動" Grid.Column="2" IsChecked="{Binding MouseScrollAuto}" Margin="{StaticResource AppMarginL}" Name="checkBox_mouseScrollAuto" Style="{StaticResource AppCheckBoxStyle}" />
                            <FrameworkElement Grid.Row="1" Margin="{StaticResource AppMarginT}" />
                            <Label Content="マウス横スクロールサイズ" Grid.Row="2" Style="{StaticResource AppTermLabelStyle}" />
                            <TextBox Grid.Column="1" Grid.Row="2" InputMethod.IsInputMethodEnabled="False" IsEnabled="{Binding IsChecked, Converter={StaticResource invert}, ElementName=checkBox_mouseHorizontalScrollAuto}" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding HorizontalScrollSize}" />
                            <CheckBox Content="自動" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Left" IsChecked="{Binding MouseHorizontalScrollAuto}" Margin="{StaticResource AppMarginL}" Name="checkBox_mouseHorizontalScrollAuto" Style="{StaticResource AppCheckBoxStyle}" />
                            <FrameworkElement Grid.Row="3" Margin="{StaticResource AppMarginT}" />
                            <Label Content="サービス１つの幅" Grid.Row="4" Style="{StaticResource AppTermLabelStyle}" />
                            <TextBox Grid.Column="1" Grid.Row="4" InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding ServiceWidth}" />
                            <FrameworkElement Grid.Row="5" Margin="{StaticResource AppMarginT}" />
                            <Label Content="サービスのロゴの高さ" Grid.Row="6" Style="{StaticResource AppTermLabelStyle}" />
                            <TextBox Grid.Column="1" Grid.Row="6" InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding ServiceLogoHeight}" />
                            <Label Content="px (標準モード。0で行の高さに合わせる)" Grid.Column="2" Grid.ColumnSpan="6" Grid.Row="6" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppLabelStyle}" />
                            <Label Content="1分あたりの高さ" Grid.Column="3" Margin="{StaticResource AppIndentMargin}" Style="{StaticResource AppTermLabelStyle}" />
                            <TextBox Grid.Column="4" InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding MinHeight}" />
                            <Label Content="ドラッグスクロール倍率" Grid.Column="3" Grid.Row="2" Margin="{StaticResource AppIndentMargin}" Style="{StaticResource AppTermLabelStyle}" />
                            <TextBox Grid.Column="4" Grid.Row="2" InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding DragScroll}" />
                            <Label Content="最低表示行数" Grid.Column="5" Grid.ColumnSpan="2" Margin="{StaticResource AppIndentMargin}" Style="{StaticResource AppTermLabelStyle}" />
                            <TextBox Grid.Column="7" InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding MinimumHeight}" />
                            <Label Content="枠線の幅" Grid.Column="5" Grid.Row="2" Margin="{StaticResource AppIndentMargin}" Style="{StaticResource AppTermLabelStyle}" />
                            <TextBox Grid.Column="6" Grid.Row="2" InputMethod.IsInputMethodEnabled="False" Margin="{StaticResource AppMarginR}" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding EpgBorderLeftSize}" />
                            <TextBox Grid.Column="7" Grid.Row="2" InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding EpgBorderTopSize}" />
                        </Grid>
                        <DockPanel Margin="{StaticResource AppWideMarginT}">
                            <StackPanel DockPanel.Dock="Left">
                                <CheckBox Content="番組内容表示位置を番組名表示位置にあわせる" HorizontalAlignment="Left" IsChecked="{Binding EpgTitleIndent}" Style="{StaticResource AppCheckBoxStyle}" />
                                <CheckBox Content="詳細も表示" HorizontalAlignment="Left" IsChecked="{Binding EpgExtInfoTable}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppCheckBoxStyle}" />
                                <CheckBox Content="番組表記号([字]など)を画像で表示する" HorizontalAlignment="Left" IsChecked="{Binding EpgSymbolImage}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppCheckBoxStyle}" />
                                <CheckBox Content="詳細をツールチップ表示する" HorizontalAlignment="Left" IsChecked="{Binding EpgToolTip}" Margin="{StaticResource AppMarginT}" Name="checkBox_descToolTip" Style="{StaticResource AppCheckBoxStyle}" />
                                <StackPanel IsEnabled="{Binding IsChecked, ElementName=checkBox_descToolTip, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource AppIndentMargin}">
                                    <CheckBox Content="番組名を表示しきれない物のみ表示" HorizontalAlignment="Left" IsChecked="{Binding EpgToolTipNoViewOnly}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppCheckBoxStyle}" />
                                    <StackPanel Margin="{StaticResource AppMarginT}" Orientation="Horizontal">
                                        <Label Content="ツールチップを表示するまでの時間(ミリ秒)" Style="{StaticResource AppTermLabelStyle}" />
                                        <TextBox InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding EpgToolTipViewWait}" />
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox Content="番組内容をポップアップ表示する" HorizontalAlignment="Left" IsChecked="{Binding EpgPopup}" Margin="{StaticResource AppMarginT}" Name="checkBox_epgPopup" Style="{StaticResource AppCheckBoxStyle}" />
                                <StackPanel IsEnabled="{Binding IsChecked, ElementName=checkBox_epgPopup, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource AppIndentMargin}">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Content="なるべく画面内に収める" IsChecked="{Binding EpgAdjustPopup}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppCheckBoxStyle}" />
                                        <CheckBox Content="詳細も表示" IsChecked="{Binding EpgExtInfoPopup}" Margin="{StaticResource AppMarginLT}" Style="{StaticResource AppCheckBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="{StaticResource AppMarginT}" Orientation="Horizontal">
                                        <Label Content="ポップアップの幅(0で番組の幅に合わせる)" Style="{StaticResource AppTermLabelStyle}" />
                                        <TextBox InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding EpgPopupWidth}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="{StaticResource AppIndentMargin}">
                                <Label Content="タイトルの文字列置換リスト（/置換前/置換後/…）" Margin="{StaticResource AppMarginB}" Style="{StaticResource AppLabelStyle}" />
                                <TextBox Margin="{StaticResource AppIndentMargin}" Style="{StaticResource AppTextBoxStyle}" Text="{Binding EpgReplacePatternTitle}" />
                                <Label Content="タイトル以外の文字列置換リスト（〃）" Margin="{StaticResource AppMarginTB}" Style="{StaticResource AppLabelStyle}" />
                                <TextBox Margin="{StaticResource AppIndentMargin}" Style="{StaticResource AppTextBoxStyle}" Text="{Binding EpgReplacePattern}" />
                                <TextBlock Margin="{StaticResource AppMarginT}" />
                                <CheckBox Content="シングルクリックで予約ダイアログを開く" HorizontalAlignment="Left" Margin="{StaticResource AppMarginT}" IsChecked="{Binding EpgInfoSingleClick}" Style="{StaticResource AppCheckBoxStyle}" />
                                <CheckBox Content="番組詳細タブを選択した状態で予約ダイアログを開く" HorizontalAlignment="Left" Margin="{StaticResource AppMarginT}" IsChecked="{Binding EpgInfoOpenMode, Converter={StaticResource convert}}" Style="{StaticResource AppCheckBoxStyle}" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Margin="{StaticResource AppWideMarginT}" Orientation="Horizontal">
                            <Label Content="グラデーション表示を行う" Style="{StaticResource AppTermLabelStyle}" />
                            <CheckBox Content="番組" IsChecked="{Binding EpgGradation}" Style="{StaticResource AppCheckBoxStyle}" />
                            <CheckBox Content="サービス・時刻軸" IsChecked="{Binding EpgGradationHeader}" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppCheckBoxStyle}" />
                        </StackPanel>
                        <CheckBox Content="サービス名の下にネットワーク名・番号(リモコンキー)も表示する(標準モード)" HorizontalAlignment="Left" IsChecked="{Binding EpgServiceDetail}" Margin="{StaticResource AppWideMarginT}" Style="{StaticResource AppCheckBoxStyle}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </TabItem>
        <TabItem Header="色">
            <StackPanel Grid.IsSharedSizeScope="True" Margin="{StaticResource AppEdgeMarginLTR}" Name="grid_color" DataContextChanged="grid_color_DataContextChanged">
                <StackPanel Orientation="Horizontal">
                    <Label Content="デザイン" Style="{StaticResource AppTermLabelStyle}" />
                    <UniformGrid Rows="1">
                        <RadioButton Content="デフォルト" IsChecked="True" Name="radioButton_colorDesignDefault" Style="{StaticResource AppToggleButtonStyle}" Checked="radioButton_colorDesign_Checked" />
                        <RadioButton Content="サブ1" Name="radioButton_colorDesignSub1" Style="{StaticResource AppToggleButtonStyle}" Checked="radioButton_colorDesign_Checked" />
                        <RadioButton Content="サブ2" Name="radioButton_colorDesignSub2" Style="{StaticResource AppToggleButtonStyle}" Checked="radioButton_colorDesign_Checked" />
                    </UniformGrid>
                    <Label Content="※デフォルトデザインの設定の一部は番組表以外にも影響します。" IsEnabled="{Binding IsChecked, ElementName=radioButton_colorDesignDefault}" Margin="{StaticResource AppWideMarginL}" Style="{StaticResource AppLabelStyle}" />
                </StackPanel>
                <GroupBox Header="文字色" Margin="{StaticResource AppWideMarginT}">
                    <Grid Margin="{StaticResource AppMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="column0" Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition SharedSizeGroup="column2" Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Content="タイトル" Grid.Row="0" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="1" Grid.Row="0" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox_colorTitle1" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                        <Button Content="　　　　　" Grid.Column="2" Grid.Row="0" Name="button_colorTitle1" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        <StackPanel Grid.Column="3" Grid.Row="0" Orientation="Horizontal">
                            <Label Content="影のぼかし具合" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppTermLabelStyle}" />
                            <local:SpinTextBox InputMethod.IsInputMethodEnabled="False" Fallback="0" Minimum="0" Text="{Binding TitleBlurRadius}" Width="120" />
                            <Label Content="px" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppLabelStyle}" />
                            <CheckBox Content="影の色" IsChecked="{Binding TitleBlurColorEnabled}" Margin="{StaticResource AppWideMarginL}" Name="checkBox_blurTitle" Style="{StaticResource AppCheckBoxStyle}" />
                            <ComboBox IsEnabled="{Binding IsChecked, ElementName=checkBox_blurTitle}" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginL}" Name="comboBox_blurTitle" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                            <Button Content="　　　　　" IsEnabled="{Binding IsChecked, ElementName=checkBox_blurTitle}" Margin="{StaticResource AppMarginL}" Name="button_blurTitle" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        </StackPanel>
                        <FrameworkElement Grid.Row="1" Margin="{StaticResource AppMarginT}" />
                        <Label Content="タイトル以外" Grid.Row="2" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="1" Grid.Row="2" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox_colorTitle2" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                        <Button Content="　　　　　" Grid.Column="2" Grid.Row="2" Name="button_colorTitle2" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        <StackPanel Grid.Column="3" Grid.Row="2" Orientation="Horizontal">
                            <Label Content="影のぼかし具合" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppTermLabelStyle}" />
                            <local:SpinTextBox InputMethod.IsInputMethodEnabled="False" Fallback="0" Minimum="0" Text="{Binding BodyBlurRadius}" Width="120" />
                            <Label Content="px" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppLabelStyle}" />
                            <CheckBox Content="影の色" IsChecked="{Binding BodyBlurColorEnabled}" Margin="{StaticResource AppWideMarginL}" Name="checkBox_blurBody" Style="{StaticResource AppCheckBoxStyle}" />
                            <ComboBox IsEnabled="{Binding IsChecked, ElementName=checkBox_blurBody}" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginL}" Name="comboBox_blurBody" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                            <Button Content="　　　　　" IsEnabled="{Binding IsChecked, ElementName=checkBox_blurBody}" Margin="{StaticResource AppMarginL}" Name="button_blurBody" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        </StackPanel>
                        <FrameworkElement Grid.Row="3" Margin="{StaticResource AppMarginT}" />
                        <Label Content="サービス名" Grid.Row="4" Style="{StaticResource AppTermLabelStyle}" />

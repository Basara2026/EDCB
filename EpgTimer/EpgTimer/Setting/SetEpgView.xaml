                    <CheckBox Content="標準モードのすべてのタブを同期スクロールする" HorizontalAlignment="Left" IsChecked="{Binding SynchronizeEpgScroll}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppCheckBoxStyle}" />
                    <CheckBox Content="サービス・日付を左クリックで表示モードを切り替える" HorizontalAlignment="Left" IsChecked="{Binding ToggleEpgModeOnHeaderLeftClick}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppCheckBoxStyle}" />
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="サービス名">
            <Grid Margin="{StaticResource AppEdgeMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Label Content="番組表に表示するサービス名を変更できます。空欄にすると元の名前に戻ります。(表示上のみで内部のサービス名は変わりません。)" Margin="{StaticResource AppMarginTB}" Style="{StaticResource AppLabelStyle}" />
                <ListView Grid.Row="1" Name="listView_serviceAlias" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView x:Name="gridView_serviceAlias">
                            <GridViewColumn DisplayMemberBinding="{Binding Path=OriginalName}" Header="元のサービス名" Width="220" />
                            <GridViewColumn DisplayMemberBinding="{Binding Path=NetworkName}" Header="ネットワーク" Width="100" />
                            <GridViewColumn Header="表示名" Width="280">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{Binding Path=DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="250" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
